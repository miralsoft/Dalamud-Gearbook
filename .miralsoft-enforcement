# MIRAL Soft enforcement configuration.
# Read by the git hooks in .git/hooks/ and by .github/workflows/content-checks.yml, which
# reads these same two keys so the local and the server-side check can never disagree about
# what is covered (R-17).

# R-03, R-19: the email is the same for every project; the name says which kind it is.
# Gearbook is a private project, so it commits as Sanaka. This must match what
# docs/project.md declares.
OWNER_NAME=Sanaka
OWNER_EMAIL=20637644+miralsoft@users.noreply.github.com

# Files checked for em-dash characters (I-02). These are matched with `case`, where `*` also
# spans a slash, so `*.md` already reaches every depth. The JSON globs matter here because the
# language catalogues and the release notes are prose that reaches a player through a compiled
# resource, which is exactly the reach I-02 names.
CONTENT_GLOBS=*.md *.json *.ps1 *.cs *.yml

# Skipped even where the globs match. These are generated rather than written, so a character
# in them would be somebody else's. The leading `*` is required: the patterns are matched
# against the full path from the repository root, so a bare file name would never match a file
# in a subdirectory.
CONTENT_EXCLUDE=*packages.lock.json *pluginmaster.json
