<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The clear is the point of this file. Without it, a feed configured machine-wide somewhere
    else is silently added to the list and restored from, which is a package source nobody in
    this repository chose (S-05, S-08).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
